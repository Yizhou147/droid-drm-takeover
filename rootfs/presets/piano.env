# piano 机型预设 —— 除「机型 / 发行版 / 用户名 / 桌面」四项表单之外，
# 所有构建开关的**唯一取值来源**。取值 = 上游 Droidspaces-rootfs-KDE-builder
# 中文 workflow（build-rootfs-releases.yml）的默认值，本次移植不改任何一项。
#
# 目标机型：Xiaomi Pad 8 Pro（代号 piano，SoC SM8750 / Adreno 830）。
# 这些变量由 build_rootfs.sh 的 `: "${VAR:=默认}"` 读取；命令行 -X 参数仍可覆盖它们，
# 但 workflow 不传 -X，所以 CI 上生效的就是这里写的值。

# 桌面自启动：装 desktop-session.service，容器起来即进 KDE
DESKTOP_AUTOSTART=true

# 显示后端：anland-wayland（上游中文默认）。KDE mobile/GNOME/Anland Next 会强制此值。
DISPLAY_BACKEND_INPUT=anland-wayland

# 音频转发：X11 后端下用 socket；anland-wayland 时脚本会自动改成 none
PulseAudio=socket

# 中文 locale + 上海时区
ENABLE_zh_tz=true

# 骁龙 GPU（kgsl / Mesa）支持
ENABLE_mesa=true

# 骁龙 8 Gen 2 的 Turnip UBWC Wayland 花屏修复：piano 是 SM8750，不需要
ENABLE_8gen2_wayland=false

# 移除 Ubuntu Snap/snapd 并阻止 APT 重装
ENABLE_nosnap=true

# systemd 257 旧内核兼容（实验性，只支持 none 与普通 KDE）
ENABLE_systemd257=false

# fcitx5 输入法
ENABLE_srf=true

# binfmt 跨架构支持
ENABLE_binfmt=false

# NAT 与安卓/Droidspaces 硬件识别
ENABLE_yj=true

# 开发工具链
ENABLE_kfgj=false

# 压缩工具
ENABLE_zip=true

# 在 rootfs 里装 Docker
ENABLE_docker=false

# Anland KDE 包来源
ANLAND_RELEASE_REPOSITORY=Goldzxcbug/droidspaces-package

# ===== 本项目追加的开关（不属上游那 14 项）=====
# 出厂 rootfs 预装接管 drmtui（跑 droid-drm-takeover 的 --preinstall-offline）。
# piano 必须为 true：这就是"装完就能进 DRM 接管"的那一半。
ENABLE_drmtui=true
