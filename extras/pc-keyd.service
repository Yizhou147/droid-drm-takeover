[Unit]
Description=plasma-keyboard PC-layout combo key injector (uinput)
# !! 09-23 起禁止 enable（保持 disable）：开机时 /dev/uinput 尚不存在会 crash-loop，
# 快速反复拉起会触发小米内核 uinput 防滥用（本启动会话内所有注入被静默丢弃）。
# 启动统一走 desk-takeover.sh / startanland-kde.sh 的 nohup（节点已由接管脚本保证）。
# 本单元仅保留为手动兜底：手动 start 前确认 /dev/uinput 已存在，且严禁 Restart 风暴。
After=systemd-udevd.service

[Service]
# /dev 是 tmpfs：开机时 uinput 节点还不存在，直接起会 crash-loop（09-23 实锤）。
# 与接管脚本建的节点一致（c 10 223, 0666），谁先建都一样。
ExecStartPre=/bin/sh -c 'test -e /dev/uinput || { mknod /dev/uinput c 10 223 && chmod 666 /dev/uinput; }'
ExecStart=/usr/bin/python3 /usr/local/bin/pc-keyd.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
